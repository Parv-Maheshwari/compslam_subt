<launch>

  <!-- Module options -->
  <arg name="run_compslam_lio"             default="true"/>
  <arg name="run_compslam_vtio"            default="true"/>
  <arg name="run_compslam_se"              default="false"/>

  <!-- Lidar options for compslam_lio -->
  <arg name="compslam_lio_with_OS0128"     default="false"/> # Options: false -> VLP16, true -> OS0128

  <!-- CompSLAM LIO -->
  <include file="$(find compslam_lio)/launch/compslam_lio.launch" if="$(arg run_compslam_lio)">
    <arg name="compslam_lio_with_OS0128"   value="$(arg compslam_lio_with_OS0128)"/>
  </include>

  <!-- CompSLAM VTIO -->
  <include file="$(find compslam_vtio)/launch/compslam_vtio.launch" if="$(arg run_compslam_vtio)"/>

</launch>