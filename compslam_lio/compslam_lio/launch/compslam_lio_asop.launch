<launch>
  <!-- Run the CompSLAM LIO Nodelets in a specific namespace -->
  <arg name="ns" default="compslam_lio"/>

  <!-- Input topics remap -->
  <arg name="pointcloud_topic_name" default="/ouster_points_self_filtered" />
  <arg name="imu_topic_name" default="/microstrain_imu_node/microstrain_imu" />

  <!-- Config params -->
  <arg name="config_filename" default="$(find compslam_lio)/config/compslam_lio_OS0128_asop_params.yaml"/>

  <!-- Launch compslam_lio -->
  <include file="$(find compslam_lio)/launch/compslam_lio.launch">
    <arg name="ns" value="$(arg ns)"/>
    <arg name="pointcloud_topic_name" value="$(arg pointcloud_topic_name)"/>
    <arg name="imu_topic_name" value="$(arg imu_topic_name)"/>
    <arg name="config_filename" value="$(arg config_filename)"/>
  </include>

</launch>
