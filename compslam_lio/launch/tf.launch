<launch>
  <arg name="ns" default=""/>
  <arg name="server_ns" default=""/>
  <arg name="client_ns" default=""/>

  <!-- Frame Connectors -->
  <!-- Standalone CompSLAM LIO Node Frame Connectors -->
  <group if="$(eval server_ns == '' and client_ns == '')">
    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_map_corrected" respawn="true" args="0 0 0 0 0 0 map $(arg ns)/camera_init_CORRECTED"/>
    <node pkg="tf" type="static_transform_publisher" name="tf_corrected_init" respawn="true" args="0 0 0 1.570796327 0 1.570796327 $(arg ns)/camera_init_CORRECTED $(arg ns)/camera_init"/>
  </group>

  <!-- Server CompSLAM LIO Node Frame Connectors -->
  <group if="$(eval server_ns != '' and client_ns == '')">
    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_map_$(arg server_ns)_map" respawn="true" args="0 0 0 0 0 0 map $(arg server_ns)_map"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_$(arg server_ns)_map_corrected" respawn="true" args="0 0 0 0 0 0 $(arg server_ns)_map $(arg server_ns)/$(arg ns)/camera_init_CORRECTED"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_$(arg server_ns)_corrected_init" respawn="true" args="0 0 0 1.570796327 0 1.570796327 $(arg server_ns)/$(arg ns)/camera_init_CORRECTED $(arg server_ns)/$(arg ns)/camera_init"/>
  </group>

  <!-- Client CompSLAM LIO Node Frame Connectors -->
  <group if="$(eval server_ns == '' and client_ns != '')">
    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_map_$(arg client_ns)_map" respawn="true" args="0 0 0 0 0 0 map $(arg client_ns)_map"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_$(arg client_ns)_map_corrected" respawn="true" args="0 0 0 0 0 0 $(arg client_ns)_map $(arg client_ns)/$(arg ns)/camera_init_CORRECTED"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="tf_$(arg client_ns)_corrected_init" respawn="true" args="0 0 0 1.570796327 0 1.570796327 $(arg client_ns)/$(arg ns)/camera_init_CORRECTED $(arg client_ns)/$(arg ns)/camera_init"/>
  </group>
  
  # Case server_ns != '' and client_ns != '' not handled!
</launch>